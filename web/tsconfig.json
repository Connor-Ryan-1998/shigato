{
	"extends": "$app/tsconfig",
	"include": ["src", "e2e", "*"],
	"compilerOptions": {
		"strict": true,
		"moduleResolution": "bundler",
		"module": "esnext",
		"target": "esnext",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": true
	}
}
