/bin/
/data/
.env
/docker-compose.override.yml
/.local/
.superpowers/

# internal/webui/dist is `task web:build`'s output. Only .gitkeep is
# tracked, so a fresh checkout has an empty dist/ (go:embed still needs the
# directory to exist) and `go build`/`go test` work without Node: webui.go
# serves a built-in "not built" page when index.html is absent.
# `task web:build` empties this directory (adapter-static's own behaviour)
# and recreates .gitkeep afterwards, so `git status` stays clean.
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

/web/node_modules/
/web/.svelte-kit/
/web/build/
/web/test-results/
/web/playwright-report/
